CREATE TABLE observations_temp (
    internal_id_observation INTEGER PRIMARY KEY AUTOINCREMENT,
    observation_unit_id TEXT,
    observation_variable_db_id INTEGER,
    study_id INTEGER,
    observation_db_id TEXT,
    value TEXT,
    observation_time_stamp TEXT,
    collector TEXT,
    geo_coordinates TEXT,
    last_synced_time TEXT,
    additional_info TEXT,
    rep TEXT,
    notes TEXT
);

INSERT INTO observations_temp (
    internal_id_observation,
    observation_unit_id,
    observation_variable_db_id,
    study_id,
    value,
    observation_time_stamp,
    collector,
    geo_coordinates,
    last_synced_time,
    additional_info,
    rep,
    notes
)
SELECT
    internal_id_observation,
    observation_unit_id,
    observation_variable_db_id,
    study_id,
    value,
    observation_time_stamp,
    collector,
    geoCoordinates,
    last_synced_time,
    additional_info,
    rep,
    notes
FROM observations;

DROP TABLE observations;
ALTER TABLE observations_temp RENAME TO observations;

CREATE VIEW IF NOT EXISTS VisibleObservationVariable AS
    SELECT
        internal_id_observation_variable,
        observation_variable_name,
        observation_variable_field_book_format,
        observation_variable_details,
        default_value,
        position
    FROM observation_variables
    WHERE visible LIKE "true"
    ORDER BY position;

CREATE VIEW IF NOT EXISTS NonImageObservations AS
    SELECT
        observations.internal_id_observation AS id,
        observations.value AS value,
        studies.internal_id_study AS study_db_id,
        observation_variables.trait_data_source
    FROM observations
    JOIN observation_variables
        ON observations.observation_variable_db_id = observation_variables.internal_id_observation_variable
    JOIN studies
        ON observations.study_id = studies.internal_id_study
    WHERE observation_variables.observation_variable_field_book_format <> 'photo';

CREATE VIEW IF NOT EXISTS LocalImageObservations AS
    SELECT
        observations.internal_id_observation AS id,
        observations.value AS value,
        studies.internal_id_study AS study_id,
        observation_variables.observation_variable_name AS observation_variable_name
    FROM observations
    JOIN observation_variables
        ON observations.observation_variable_db_id = observation_variables.internal_id_observation_variable
    JOIN studies
        ON observations.study_id = studies.internal_id_study
    WHERE (observation_variables.trait_data_source = 'local' OR observation_variables.trait_data_source IS NULL)
        AND observation_variables.observation_variable_field_book_format = 'photo';

CREATE VIEW IF NOT EXISTS RemoteImageObservationsView AS
    SELECT
        observations.internal_id_observation AS id,
        observations.value AS value,
        studies.internal_id_study AS study_id,
        observation_variables.trait_data_source AS trait_data_source,
        observation_variables.observation_variable_field_book_format,
        observation_variables.observation_variable_name
    FROM observations
    JOIN observation_variables
        ON observations.observation_variable_db_id = observation_variables.internal_id_observation_variable
    JOIN studies
        ON observations.study_id = studies.internal_id_study
    WHERE studies.study_source IS NOT NULL
        AND observation_variables.trait_data_source <> 'local'
        AND observation_variables.trait_data_source IS NOT NULL
        AND observation_variables.observation_variable_field_book_format = 'photo';
