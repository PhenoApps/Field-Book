-- Migration: upgrade from DB version 17 -> 18
-- Allow camera traits to store multiple photos for the same plot.

CREATE TABLE observations_without_unique (
    internal_id_observation INTEGER PRIMARY KEY,
    study_id INTEGER REFERENCES studies(internal_id_study) NOT NULL,
    observation_variable_db_id INTEGER REFERENCES observation_variables(internal_id_observation_variable) NOT NULL,
    observation_unit_id TEXT NOT NULL REFERENCES observation_units(internal_id_observation_unit),
    value TEXT,
    observation_time_stamp TEXT,
    collector TEXT,
    geo_coordinates TEXT,
    observation_db_id TEXT,
    last_synced_time TEXT,
    additional_info TEXT,
    rep TEXT,
    notes TEXT
);

INSERT INTO observations_without_unique (
    internal_id_observation,
    study_id,
    observation_variable_db_id,
    observation_unit_id,
    value,
    observation_time_stamp,
    collector,
    geo_coordinates,
    observation_db_id,
    last_synced_time,
    additional_info,
    rep,
    notes
)
SELECT
    internal_id_observation,
    study_id,
    observation_variable_db_id,
    observation_unit_id,
    value,
    observation_time_stamp,
    collector,
    geo_coordinates,
    observation_db_id,
    last_synced_time,
    additional_info,
    rep,
    notes
FROM observations;

DROP TABLE observations;
ALTER TABLE observations_without_unique RENAME TO observations;
