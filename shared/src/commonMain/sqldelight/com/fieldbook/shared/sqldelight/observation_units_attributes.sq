CREATE TABLE observation_units_attributes (
  internal_id_observation_unit_attribute INTEGER NOT NULL PRIMARY KEY,
  observation_unit_attribute_name TEXT NOT NULL
);

getAllNamesByStudyId:
SELECT DISTINCT a.observation_unit_attribute_name
FROM observation_units_attributes a
JOIN observation_units_values v
  ON v.observation_unit_attribute_db_id = a.internal_id_observation_unit_attribute
WHERE v.study_id = ?
ORDER BY a.observation_unit_attribute_name;

getAllIdsByStudyId:
SELECT DISTINCT a.internal_id_observation_unit_attribute, a.observation_unit_attribute_name
FROM observation_units_attributes a
JOIN observation_units_values v
  ON v.observation_unit_attribute_db_id = a.internal_id_observation_unit_attribute
WHERE v.study_id = ?;

getIdByName:
SELECT internal_id_observation_unit_attribute
FROM observation_units_attributes
WHERE observation_unit_attribute_name = ?
LIMIT 1;

getLastInsertedId:
SELECT last_insert_rowid();

insertObservationUnitAttribute:
INSERT OR IGNORE INTO observation_units_attributes (
  observation_unit_attribute_name
) VALUES (?);
