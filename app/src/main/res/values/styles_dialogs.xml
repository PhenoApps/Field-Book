<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Generic dialog theme for field creator dialog -->
    <style name="AlertCheckedView" parent="Base.Widget.MaterialComponents.CheckedTextView">
        <item name="android:textSize">?attr/fb_title_text_size</item>
        <item name="android:textColor">?attr/fb_color_text_dark</item>
        <item name="android:checkMarkTint">?attr/fb_icon_tint</item>
        <item name="colorAccent">?attr/fb_color_accent</item>
    </style>

    <!-- Dialog theme inherits app palette attrs (fb_*) so AlertDialog content matches appearance. -->
    <style name="Theme.FieldBook.Dialog.Alert" parent="BaseAppTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSoftInputMode">stateUnchanged</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="DialogEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/dialog_edit_text</item>
        <item name="android:textColorHint">@color/dialog_hint_text</item>
        <item name="android:textSize">?attr/fb_body_text_size</item>
    </style>

    <style name="DialogTextInputLayoutStyle" parent="FieldBookTextInputLayoutStyle" />

    <style name="FieldBookTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="hintTextColor">@color/textinput_hint_fieldbook</item>
        <item name="android:textColorHint">@color/textinput_hint_fieldbook</item>
        <item name="boxBackgroundColor">?attr/fb_color_card_background</item>
        <item name="boxStrokeColor">?attr/fb_color_accent</item>
    </style>

    <style name="FieldCreatorSectionTitle" parent="TextViewStyle.Bold.Title">
        <item name="android:textColor">?attr/fb_color_text_light</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AppAlertDialog" parent="Theme.FieldBook.Dialog.Alert">

        <item name="android:colorBackground">?attr/fb_color_background</item>
        <item name="android:windowBackground">?attr/fb_color_background</item>
        <item name="android:textColorPrimary">?attr/fb_color_text_dark</item>
        <item name="android:textColorSecondary">?attr/fb_color_text_secondary</item>
        <item name="android:textColorHint">?attr/fb_color_hint_text</item>
        <item name="colorControlNormal">?attr/fb_icon_tint</item>
        <item name="editTextStyle">@style/DialogEditTextStyle</item>
        <item name="android:editTextStyle">@style/DialogEditTextStyle</item>
        <item name="textInputStyle">@style/DialogTextInputLayoutStyle</item>

        <item name="buttonBarNegativeButtonStyle">@style/ButtonBarStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/ButtonBarStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/ButtonBarStyle</item>

        <item name="android:background">@color/TRANSPARENT</item>

        <item name="checkedTextViewStyle">@style/AlertCheckedView</item>

        <item name="colorAccent">?attr/fb_color_accent</item>

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:windowTitleBackgroundStyle">@android:color/transparent</item>
        <item name="android:windowTitleStyle">@style/DialogTitleStyle</item>

        <item name="floatingActionButtonStyle">@style/FloatingActionButtonStyle</item>
        <item name="imageButtonStyle">@style/ImageButtonStyle</item>
        <item name="radioButtonStyle">@style/RadioButtonStyle</item>
        <item name="buttonStyle">@style/ButtonStyle</item>
        <item name="android:buttonStyleToggle">@style/ToggleButtonStyle</item>
        <item name="toolbarStyle">@style/AppToolbar</item>
        <item name="checkboxStyle">@style/CheckBoxStyle</item>
        <item name="actionOverflowButtonStyle">@style/OverFlowStyle</item>
        <item name="progressBarStyle">@style/ProgressBarStyle</item>
        <item name="indeterminateProgressStyle">@style/IndeterminateProgressStyle</item>
        <item name="android:textViewStyle">@style/TextViewStyle</item>
        <item name="spinnerDropDownItemStyle">@style/SpinnerDropDownItemStyle</item>
        <item name="dropDownListViewStyle">@style/DropDownListViewStyle</item>
        <item name="android:checkedTextViewStyle">@style/AlertCheckedView</item>
    </style>

    <style name="AppAlertDialog.Preference" parent="AppAlertDialog">
        <item name="android:windowBackground">@drawable/inset_border</item>
    </style>

    <style name="DialogTitleStyle">
        <item name="android:textColor">?attr/fb_color_text_dark</item>
        <item name="android:background">?attr/fb_color_background</item>
        <item name="android:textSize">?attr/fb_title_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AppCompat.Subhead" parent="Base.TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">?attr/fb_title_text_size</item>
        <item name="android:textColor">?attr/fb_color_text_dark</item>
    </style>

    <style name="TextAppearance.AppCompat.Title" parent="Base.TextAppearance.AppCompat.Title">
        <item name="android:textSize">?attr/fb_title_text_size</item>
        <item name="android:textColor">?attr/fb_color_text_dark</item>
    </style>

    <style name="TextAppearance.AppCompat.Button" parent="Base.TextAppearance.AppCompat.Button">
        <item name="android:textSize">?attr/fb_title_text_size</item>
    </style>

    <!-- Section headers inside alert dialog custom views (uses dialog theme textColorPrimary). -->
    <style name="TextViewStyle.Bold.Dialog" parent="TextViewStyle.Bold">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextViewStyle.Bold.Title.Dialog" parent="TextViewStyle.Bold.Title">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

</resources>