<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- MFlisar changelog library (com.github.MFlisar:changelog) -->

    <!-- Used by AlertDialog.Builder(activity); fragment setStyle alone does not apply. -->
    <style name="AppAlertDialog.SodaDark" parent="Theme.SodaDark.Palette.Dialog">
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="ChangelogDialogDarkTheme" parent="AppAlertDialog.SodaDark">
        <item name="android:windowNoTitle">false</item>
    </style>

    <style name="ChangelogRow">
        <item name="android:textAppearance">@android:style/TextAppearance.Small</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="ChangelogHeader">
        <item name="android:textAppearance">@android:style/TextAppearance.Medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="ChangelogHeaderDate" parent="ChangelogHeader">
        <item name="android:textAppearance">@android:style/TextAppearance.Small</item>
    </style>

    <style name="ChangelogHeaderVersion" parent="ChangelogHeader" />

    <!-- Keep New (green) and Bug (red) labels from the library defaults. -->
    <string name="changelog_bug_improvement">[font color="#009933"][b]New: [/b][/font]</string>
    <string name="changelog_bug_prefix">[font color="#FF0000"][b]Bug: [/b][/font]</string>

</resources>
