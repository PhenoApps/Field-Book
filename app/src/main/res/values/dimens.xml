<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- crop handle default size -->
    <dimen name="crop_handle_size">32dp</dimen>

    <!-- landscape image preview sizes for camera trait recycler view, these should be 4:3-->
    <dimen name="camera_preview_landscape_width">150dp</dimen>
    <dimen name="camera_preview_landscape_height">115dp</dimen>

    <!-- portrait image preview sizes for camera trait recycler view, these should be 4:3.
         Compact values; values-h400dp and values-h480dp grow them. -->
    <dimen name="camera_preview_portrait_width">123dp</dimen>
    <dimen name="camera_preview_portrait_height">160dp</dimen>

    <!--
        Upper bounds for the crop surface, a bit larger than the preview. The surface is sized as
        a percentage of the window at 3:4 and clamped to these, so a phone reproduces the
        previous fixed 340x480dp while a short window shrinks instead.
    -->
    <dimen name="crop_image_max_width">340dp</dimen>
    <dimen name="crop_image_max_height">480dp</dimen>

    <!--
        Height-bucketed sizing. -hNdp means "available height >= N dp" and there is no maximum
        height qualifier, so the buckets run SMALLEST FIRST: this file holds the compact values
        (windows shorter than 400dp) and values-h400dp then values-h480dp grow them. Inverting
        this gives tall windows the cramped sizes.

        Height rather than smallest-width qualified because the constraint is vertical room,
        which a -sw qualifier cannot see: an unfolded foldable in landscape is sw600dp AND short.

        The info bar needs a cap because it grows one row per selected attribute, and
        svTraitContainer - the only flexible element in the chain - absorbs the whole deficit.
    -->
    <dimen name="fb_collect_infobar_max_height">64dp</dimen>
    <dimen name="fb_collect_trait_container_min_height">100dp</dimen>

    <dimen name="brapi_importer_filter_height">40dp</dimen>

    <!-- text sizes -->
    <!-- regular text -->
    <dimen name="text_size_small">14sp</dimen>
    <dimen name="text_size_medium">16sp</dimen>
    <dimen name="text_size_large">20sp</dimen>
    <dimen name="text_size_xlarge">24sp</dimen>

    <!-- sub headings -->
    <dimen name="sub_text_size_small">10sp</dimen>
    <dimen name="sub_text_size_medium">14sp</dimen>
    <dimen name="sub_text_size_large">18sp</dimen>
    <dimen name="sub_text_size_xlarge">22sp</dimen>

    <!-- title text sizes -->
    <dimen name="title_text_size_small">18sp</dimen>
    <dimen name="title_text_size_medium">20sp</dimen>
    <dimen name="title_text_size_large">24sp</dimen>
    <dimen name="title_text_size_xlarge">28sp</dimen>

    <dimen name="button_default_width">110dp</dimen>
    <dimen name="button_width_numeric">85dp</dimen>
    <dimen name="button_width_disease">60dp</dimen>


    <dimen name="fb_trait_fab_size_small">48dp</dimen>
    <dimen name="fb_trait_fab_image_size_small">24dp</dimen>

    <dimen name="fb_trait_fab_size">76dp</dimen>
    <!--
        Floor for the spectral trait layout so the busy card is never clipped. While connecting
        the chart and both recyclers are gone, so without this the layout collapses to the height
        of the connect button and the card has nowhere to draw.
        96dp indicator + 40dp padding twice + label and its margin.
        Compact value; values-h400dp and values-h480dp grow it back to 240dp.
    -->
    <dimen name="fb_spectral_busy_card_min_height">140dp</dimen>
    <dimen name="fb_trait_big_fab_size">96dp</dimen>
    <dimen name="fb_trait_fab_image_size">38dp</dimen>
  
    <dimen name="brapi_filter_tv_padding">8dp</dimen>
    <dimen name="brapi_filter_pb_size">200dp</dimen>
  
    <dimen name="fb_trait_status_bar_icon_default_max_size">10dp</dimen>
    <dimen name="act_file_explorer_progress_bar_size">64dp</dimen>

    <dimen name="fb_trait_line_graph_selector_size">38dp</dimen>

    <!-- Height of the in-trait charts (green seeker, spectral).
         Compact value; values-h400dp and values-h480dp grow it back to 300dp. -->
    <dimen name="fb_trait_chart_height">150dp</dimen>

    <!-- Minimum height of the camera trait preview surface.
         Compact value; values-h400dp and values-h480dp grow it back to 256dp. -->
    <dimen name="fb_trait_camera_preview_min_height">128dp</dimen>

    <!--  chip related  -->
    <dimen name="chip_icon_size">24dp</dimen>
    <dimen name="chip_start_padding">6dp</dimen>
    <dimen name="chip_stroke_width">2dp</dimen>
</resources>