<?xml version="1.0" encoding="utf-8"?>
<!--
    Scrollable: AlertDialog clips a setView() layout rather than scrolling it, and a month grid
    plus header is taller than a landscape dialog. Without this the last week rows and the
    dialog buttons are unreachable.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.archit.calendardaterangepicker.customviews.DateRangeCalendarView
        android:id="@+id/calendarRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:disable_date_color="#ABABAB"
        custom:range_color="@color/range_color"
        custom:selected_date_circle_color="@color/selected_date_circle_color"
        custom:title_color="@color/calendar_header_title" />

</androidx.core.widget.NestedScrollView>
