<?xml version="1.0" encoding="utf-8"?>
<!--
    Scrollable: the 70dp top margin plus title, summary and the setup rows is taller than a
    landscape window, and AppIntroActivity is not orientation locked. This is a first-run gate,
    so a clipped setup row is a user who cannot finish onboarding.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/AppIntroDefaultHeading"
        android:id="@+id/slide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="70dp"
        android:text="" />

    <TextView
        style="@style/AppIntroDefaultText"
        android:id="@+id/slide_summary"
        android:layout_margin="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.fieldbook.tracker.views.RequiredSetupItem
            android:id="@+id/permissions_setup_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.fieldbook.tracker.views.RequiredSetupItem
            android:id="@+id/storage_definer_setup_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</LinearLayout>

</androidx.core.widget.NestedScrollView>