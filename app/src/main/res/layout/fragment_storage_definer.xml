<?xml version="1.0" encoding="utf-8"?>
<!--
    Wrapped in a scroll view so the title and summary cannot overlap the progress bar and the
    choose-directory button in a short window. This is a first-run blocking screen and
    DefineStorageActivity is not orientation locked, so on a tablet it is landscape from the
    very first launch. fillViewport keeps the button pinned to the bottom whenever there is
    room, so nothing changes on a phone.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/fb_collect_trait_container_min_height">

        <TextView style="@style/TextViewStyle.Bold.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="16dp"
            android:id="@+id/frag_storage_definer_title_tv"
            android:text="@string/storage_definer_title"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frag_storage_definer_title_tv"
            android:id="@+id/frag_storage_definer_summary_tv"
            android:layout_margin="16dp"
            android:text="@string/storage_definer_summary"/>

        <ProgressBar
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frag_storage_definer_summary_tv"
            app:layout_constraintBottom_toTopOf="@id/frag_storage_definer_choose_dir_btn"
            app:layout_constraintVertical_bias="1.0"
            android:layout_margin="16dp"
            android:id="@+id/frag_storage_definer_pb"/>

        <Button
            android:text="@string/define_button_text"
            android:id="@+id/frag_storage_definer_choose_dir_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frag_storage_definer_pb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0"
            android:layout_margin="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
