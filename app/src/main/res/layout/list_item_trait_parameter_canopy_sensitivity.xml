<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Required by BaseFormatParameter.ViewHolder; not used by this parameter -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/list_item_trait_parameter_til"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/list_item_trait_parameter_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:paddingBottom="8dp" />

    <!-- SeekBar with default-value tick mark overlaid -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <SeekBar
            android:id="@+id/canopy_param_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:max="100" />

        <!-- 2 dp vertical tick mark positioned at the default value (set in code) -->
        <View
            android:id="@+id/canopy_param_default_mark"
            android:layout_width="2dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="?colorPrimary"
            android:visibility="invisible" />

    </FrameLayout>

    <TextView
        android:id="@+id/canopy_param_threshold_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:id="@+id/canopy_param_output_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <Button
        android:id="@+id/canopy_param_test_btn"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/canopy_param_test_capture" />

    <ImageView
        android:id="@+id/canopy_param_preview_iv"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

</LinearLayout>
