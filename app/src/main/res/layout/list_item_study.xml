<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item_study_cv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:backgroundTint="@color/WHITE">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/list_item_brapi_filter_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- spins until the server reports how many units to expect, then fills as pages arrive -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/list_item_study_pb"
            android:indeterminate="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:indicatorColor="?attr/fb_color_indeterminate_progress_bar"
            app:trackColor="@color/light_gray"
            app:trackCornerRadius="2dp"
            app:indicatorSize="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/list_item_study_title_tv"
            style="@style/TextViewStyle.Bold.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/list_item_study_pb"
            app:layout_constraintHorizontal_bias="0"
            tools:text="KSU" />

        <!-- location and trial share one line, long names are ellipsized rather than wrapped -->
        <com.fieldbook.tracker.views.SharedWidthRow
            android:id="@+id/list_item_study_chip_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/list_item_study_title_tv">

            <com.google.android.material.chip.Chip
                android:id="@+id/list_item_study_location_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:chipIcon="@drawable/map_marker_outline"
                android:checkable="false"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/BLACK"
                android:ellipsize="end"
                android:singleLine="true"
                app:chipIconTint="@color/BLACK"
                app:chipBackgroundColor="@color/light_gray"
                tools:text="Manhattan, KS" />

            <com.google.android.material.chip.Chip
                android:id="@+id/list_item_trial_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_trial"
                android:checkable="false"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/BLACK"
                android:ellipsize="end"
                android:singleLine="true"
                app:chipIconTint="@color/BLACK"
                app:chipBackgroundColor="@color/light_gray"
                tools:text="PeeDee Otter Trial"/>

            <!-- observations already on the server for the whole study, used when the server can't count by level -->
            <com.google.android.material.chip.Chip
                android:id="@+id/list_item_study_observations_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_nav_drawer_collect_data"
                android:checkable="false"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/BLACK"
                android:singleLine="true"
                app:chipIconTint="@color/BLACK"
                app:chipBackgroundColor="@color/light_gray"
                tools:visibility="visible"
                tools:text="1240"/>

        </com.fieldbook.tracker.views.SharedWidthRow>

        <!-- importable observation levels, one list_item_study_level row each -->
        <LinearLayout
            android:id="@+id/list_item_study_levels_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/list_item_study_chip_group"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
