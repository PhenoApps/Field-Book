<?xml version="1.0" encoding="utf-8"?>
<com.fieldbook.tracker.traits.MultispeqTraitLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/multispeqLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <!-- Protocol selection spinner -->
        <TextView
            android:id="@+id/multispeq_protocol_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/multispeq_protocol_label"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/multispeq_protocol_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/multispeq_protocol_label" />

        <!-- Connect button (shown when disconnected) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/multispeq_connect_button"
            style="@style/FloatingActionButtonStyle.TraitButtons"
            android:layout_width="@dimen/fb_trait_fab_size"
            android:layout_height="@dimen/fb_trait_fab_size"
            android:layout_margin="16dp"
            android:src="@drawable/ic_bluetooth_black_24dp"
            android:contentDescription="@string/multispeq_connect_button_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/multispeq_protocol_spinner" />

        <!-- Connected device name (shown when connected) -->
        <TextView
            android:id="@+id/multispeq_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/multispeq_protocol_spinner" />

        <!-- Progress bar (shown while measuring) -->
        <ProgressBar
            android:id="@+id/multispeq_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/multispeq_device_name" />

        <!-- Measure / Disconnect button row (shown when connected) -->
        <Button
            android:id="@+id/multispeq_measure_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:text="@string/multispeq_measure_button"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/multispeq_disconnect_button"
            app:layout_constraintHorizontal_weight="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/multispeq_progress" />

        <Button
            android:id="@+id/multispeq_disconnect_button"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/multispeq_disconnect_button"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/multispeq_measure_button"
            app:layout_constraintTop_toBottomOf="@id/multispeq_progress" />

        <!-- Raw result display -->
        <ScrollView
            android:id="@+id/multispeq_result_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/multispeq_measure_button">

            <TextView
                android:id="@+id/multispeq_result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textSize="11sp" />

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.fieldbook.tracker.traits.MultispeqTraitLayout>
