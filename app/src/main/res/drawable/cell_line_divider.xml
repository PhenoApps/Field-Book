<?xml version="1.0" encoding="utf-8"?>
<!--
  A 1dp separator used as a divider background by list item layouts and by the
  ListDividerStyle widget style.

  Previously supplied by the TableView library, which the data grid rewrite stopped using.
  Reproduced here (same size and colour) so removing that dependency doesn't change any of
  these dividers.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="1dp"
        android:height="1dp" />
    <solid android:color="@color/cell_line_divider_color" />
</shape>
