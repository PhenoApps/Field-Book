<?xml version="1.0" encoding="utf-8"?>
<!-- pill background for a level row in a study import card, highlighted while the level is selected.
     The outline keeps selected pills visible in the high contrast theme, where the primary color is white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="?attr/fb_color_primary" />
            <stroke
                android:width="2dp"
                android:color="?attr/fb_border_color" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/light_gray" />
            <stroke
                android:width="1dp"
                android:color="?attr/fb_border_color" />
        </shape>
    </item>

</selector>
